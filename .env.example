# Copy to .env (never commit .env). Leave all blank to run in deterministic DEMO mode.
LLM_PROVIDER=            # anthropic | gemini | sarvam  (blank = demo mode, no external AI)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest    # alias for the current Flash model; pin e.g. gemini-2.5-flash if you need stability (check AI Studio)
SARVAM_API_KEY=
SARVAM_MODEL=sarvam-30b            # verify in docs.sarvam.ai
MSME_DB_PATH=data/app.db

# --- WhatsApp (Twilio sandbox) - optional, see docs/WHATSAPP.md
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+14155238886   # sandbox sender; verify in Twilio console
PUBLIC_URL=                          # exact https URL Twilio calls, e.g. https://abcd.ngrok.app/whatsapp
WA_ALLOW_UNSIGNED=0                  # 1 = local dev ONLY (accept unsigned webhook calls)

# --- shared deployment (Streamlit Cloud etc.)
MSME_MULTIUSER=0      # 1 = every browser session gets private data + auto-purge after 7 days
ADMIN_PIN=            # required to use the Admin page when MSME_MULTIUSER=1 (leave blank = admin disabled)
